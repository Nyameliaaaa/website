{
	"compilerOptions": {
		"jsx": "preserve",
		"paths": {
			"@/*": ["./src/*"],
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@composables/*": ["./src/composables/*"],
			"@data/*": ["./src/data/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@lib/*": ["./src/lib/*"],
			"@typings/*": ["./src/types/*"]
		},
		"strictNullChecks": true,
		"types": ["astro/client"]
	},
	"exclude": ["dist"],
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"]
}
