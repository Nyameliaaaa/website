---
import MarkdownProse from '@components/prose/MarkdownProse.astro';
import TableOfContents from '@components/prose/TableOfContents.vue';
import Base from '@layouts/Base.astro';
import { pageSubtitle, pageTitle } from '@lib/classes';
import type { MarkdownHeading } from 'astro';

interface Props {
	title: string;
	description: string;
	headings: MarkdownHeading[];
}

const { title, headings, description } = Astro.props;
---

<Base title={title} description={description}>
	<aside slot="left" class:list={['max-xl:hidden']}>
		<TableOfContents client:load headings={headings} />
	</aside>
	<section>
		<div class="mb-2">
			<h1 class={pageTitle}>{title}</h1>
			<p class={pageSubtitle}>{description}</p>

			<slot name="extra" />
		</div>

		<aside class="xl:hidden w-full">
			<TableOfContents client:load headings={headings} />
		</aside>
		<MarkdownProse><slot /></MarkdownProse>
	</section>
</Base>
