---
import LesbianFlag from '@/components/layout/LesbianFlag.astro';
import '@/styles/global.css';
import BackgroundMusic from '@components/layout/BackgroundMusic.vue';
import BaseHead from '@components/layout/BaseHead.astro';
import Container from '@components/layout/Container.astro';
import Footer from '@components/layout/Footer.astro';
import GoBack from '@components/layout/GoBack.astro';
import Header from '@components/layout/Header.astro';
import TransFlag from '@components/layout/TransFlag.astro';
import LatestStatus from '@components/statuses/LatestStatus.vue';
import { body } from '@lib/classes';

interface Props {
	title?: string;
	description?: string;
}
---

<!doctype html>
<html lang="en" class="mocha bg-ctp-crust selection:bg-ctp-pink selection:text-ctp-crust">
	<head>
		<BaseHead {...Astro.props} />
		<slot name="head" />
	</head>
	<body
		class:list={[
			'min-h-dvh w-screen',
			'bg-linear-to-br from-ctp-mantle via-ctp-crust to-ctp-mantle',
			'overflow-x-hidden',
		]}
	>
		<TransFlag />

		<BackgroundMusic client:only />

		<div class="h-full macchiato">
			<Container class="my-3" transition:persist>
				<Header />
			</Container>

			<Container transition:persist class={body}>
				<LatestStatus client:load />
			</Container>

			<Container class="mt-3 mb-5">
				<slot name="left" slot="left" />
				<main
					class:list={[
						'bg-ctp-mantle px-3 py-2 rounded-lg border-2 border-dashed border-ctp-pink drop-shadow-2xl drop-shadow-crust',
						body,
					]}
					transition:animate="fade"
				>
					<GoBack />

					<slot />
				</main>
				<slot name="right" slot="right" />
			</Container>

			<Container>
				<Footer />
			</Container>

			<LesbianFlag />

			<a class="hidden" rel="me" href="https://en.pronouns.page/@Nyameliaaaa"></a>
		</div>
	</body>
</html>
