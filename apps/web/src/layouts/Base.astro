---
import '@/styles/global.css';
import LatestStatus from '@client/statuses/LatestStatus.vue';
import Container from '@components/formatting/Container.astro';

import BackgroundMusic from '@client/base/BackgroundMusic.vue';
import BaseHead from '@components/base/BaseHead.astro';
import Footer from '@components/base/Footer.astro';
import Header from '@components/base/Header.astro';
import { body } from '@lib/classes';
import IconLink from '@components/link/IconLink.astro';

const pathname = Astro.url.pathname;

const getBackPath = () => {
	if (pathname.startsWith('/ramblings/tags')) {
		return '/ramblings/';
	}

	const parts = pathname.split('/').filter(Boolean);
	parts.pop();

	return '/' + parts.join('/') || '/';
};

const isPage = pathname !== '/';

interface Props {
	title?: string;
	description?: string;
}
---

<!doctype html>
<html lang="en" class="mocha selection:bg-ctp-pink selection:text-ctp-crust">
	<head>
		<BaseHead {...Astro.props} />
		<slot name="head" />
	</head>
	<body
		class:list={[
			'min-h-dvh w-screen',
			'bg-linear-to-br from-ctp-mantle via-ctp-crust to-ctp-mantle',
			'overflow-x-hidden',
		]}
	>
		<div class="sticky top-0 z-10 drop-shadow-md">
			<div class="grid grid-cols-5 h-3">
				<div class="bg-[#5bcefa]"></div>
				<div class="bg-[#f5a9b8]"></div>
				<div class="bg-[#ffffff]"></div>
				<div class="bg-[#f5a9b8]"></div>
				<div class="bg-[#5bcefa]"></div>
			</div>
		</div>

		<BackgroundMusic client:only />

		<div class="h-full macchiato">
			<Container class="my-3" transition:persist>
				<Header />
			</Container>

			<Container transition:persist class={body}>
				<LatestStatus client:load />
			</Container>

			<Container class="mt-3 mb-5">
				<slot name="left" slot="left" />
				<main
					class:list={[
						'bg-ctp-mantle px-3 py-2 rounded-lg border-2 border-dashed border-ctp-pink drop-shadow-2xl drop-shadow-crust',
						body,
					]}
					transition:animate="fade"
				>
					{
						isPage && (
							<div class="mb-3">
								<IconLink icon="chevron-left" url={getBackPath()} text="go back" />
							</div>
						)
					}

					<slot />
				</main>
				<slot name="right" slot="right" />
			</Container>

			<Container>
				<Footer />
			</Container>

			<a class="hidden" rel="me" href="https://en.pronouns.page/@Nyameliaaaa"></a>

			<Container class="mt-5 h-2 rounded-t-lg overflow-hidden w-full grid grid-cols-5">
				<div class="bg-[#d72803]"></div>
				<div class="bg-[#ff9a56]"></div>
				<div class="bg-[#ffffff]"></div>
				<div class="bg-[#d364a5]"></div>
				<div class="bg-[#a40365]"></div>
			</Container>
		</div>
	</body>
</html>
