---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import MarkdownWithTOC from '@layouts/MarkdownWithTOC.astro';
import WrapLink from '@components/link/WrapLink.astro';
import Divider from '@components/ui/Divider.astro';

export async function getStaticPaths() {
	const info = await getCollection('info');
	return info.map(page => ({
		params: { slug: page.id },
		props: page,
	}));
}

type Props = CollectionEntry<'info'>;

const page = Astro.props;
const { Content, headings } = await render(page);
---

<MarkdownWithTOC title={page.data.title} description={page.data.description} headings={headings}>
	<Content components={{ a: WrapLink, hr: Divider }} />
</MarkdownWithTOC>
