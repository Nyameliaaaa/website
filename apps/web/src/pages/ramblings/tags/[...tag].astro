---
import RamblingList from '@/components/rambling/RamblingList.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = async () => {
	const ramblings = await getCollection('ramblings');
	const tags = [...new Set(ramblings.flatMap(rambling => rambling.data.tags ?? []))];
	return tags.map(tag => ({ params: { tag }, props: { tag } }));
};

const { tag } = Astro.props;
---

<RamblingList tag={tag} />
