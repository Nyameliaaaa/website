---
import IconLink from '@components/link/IconLink.astro';
import WrapLink from '@components/link/WrapLink.astro';
import Arlecchino from '@components/ui/Arlecchino.astro';
import Divider from '@components/ui/Divider.astro';
import LinkSection from '@components/ui/LinkSection.astro';
import { flags, kin } from '@data/aboutMe';
import { meLinks, socialLinks } from '@data/links/about';
import { musicObsessions } from '@data/obsessions';
import Base from '@layouts/Base.astro';
import { heading, leadText, pageSubtitle, pageTitle, subHeading, text } from '@lib/classes';

const aboutTitle = 'about';
const aboutSub = 'this page is about me. this site also being about me is your problem';

const rgb = (hex: string) => {
	const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);

	return result ? [parseInt(result[1], 16), parseInt(result[2], 16), parseInt(result[3], 16)] : [];
};

const genFlagColors = (colors: string[]) => {
	return `background: linear-gradient(90deg, ${colors
		.map((x, index) => {
			const color = rgb(x).join(',');
			const firstPercentage = index === 0 ? 0 : (100 / colors.length) * index;
			const lastPercentage = index === colors.length - 1 ? 100 : (100 / colors.length) * (index + 1);

			return `rgb(${color}) ${firstPercentage}% ${lastPercentage}%`;
		})
		.join(',')});`;
};
---

<Base title={aboutTitle} description={aboutSub}>
	<div class="flex max-xl:flex-col gap-4">
		<article>
			<div class="mb-4">
				<h1 class={pageTitle}>{aboutTitle}</h1>
				<p class={pageSubtitle}>{aboutSub}</p>
			</div>

			<Divider />

			<section class="flex flex-col gap-3">
				<div>
					<h2 class={heading}>me</h2>
					<p class={leadText}>but what exactly *is* an amelia? hey vsauce michael here</p>
				</div>

				<ul class="list-disc list-inside">
					<li>i use it/she/fae/xe pronouns :3</li>
					<li>i am a robotpuppygirlthing btw :p</li>
					<li>i have AuDHD btw B) also impaired eyesight but hey</li>
					<li>also i <em>really</em> like planes, for some reason</li>
					<li>ive known im a girl since feb 14th, 2021 :p</li>
				</ul>

				<section>
					<h3 class={subHeading}>flags :3</h3>
					<ul class="flex flex-row gap-2 mt-1">
						{
							flags.map(flag => (
								<li
									class="relative isolate border-2 border-ctp-surface0 rounded-md bg-ctp-crust grow"
									style={genFlagColors(flag.colors)}
								>
									<div class="absolute -z-10 h-full w-full bg-ctp-crust/65" />
									<p class="text-center text-shadow-lg px-2 py-1 font-semibol shadow-md">{flag.name}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section>
					<h3 class={subHeading}>kin</h3>
					<ul class="flex flex-row gap-2 mt-1">
						{
							kin.map(kin => (
								<li class="px-2 py-1 border-2 border-ctp-surface0 rounded-md bg-ctp-crust grow">
									<p class="text-center">{kin}</p>
								</li>
							))
						}
					</ul>
				</section>

				<section>
					<h3 class={subHeading}>links</h3>
					<LinkSection links={meLinks} />
				</section>
			</section>

			<Divider />

			<section class="flex flex-col gap-3">
				<h2 class={heading}>tastes & obsessions</h2>

				<section>
					<h3 class={subHeading}>music</h3>
					<div class="mt-2 mb-3 flex flex-col gap-2">
						{
							musicObsessions.map(section => (
								<div>
									<h4
										class={text({
											color: 'tertiary',
											size: 'md',
											font: 'display',
											weight: 'medium',
											tracking: 'tight',
										})}
									>
										{section.label}
									</h4>
									<ul class="flex flex-row gap-2 mt-1">
										{section.obsessions.map(obsession => (
											<li class="px-2 py-1 border-2 border-ctp-surface0 rounded-md bg-ctp-crust grow">
												<p class="text-center">{obsession.name}</p>
											</li>
										))}
									</ul>
								</div>
							))
						}
					</div>
					<IconLink text="see all music stats" icon="music-box-multiple" url="/music" />
				</section>

				<section>
					<h3 class={subHeading}>other</h3>
					<ul class="list-disc list-inside mt-1">
						<li>
							<WrapLink href="https://backloggd.com/u/nyameliaaaa">games (backloggd)</WrapLink>
						</li>
						<li>
							<WrapLink href="https://letterboxd.com/nyamelia/">films (letterboxd)</WrapLink>
						</li>
					</ul>
				</section>
			</section>

			<Divider />

			<section class="flex flex-col gap-2">
				<div>
					<h2 class={heading}>beliefs</h2>
					<p class={leadText}>i have opinions and i WILL be sharing them</p>
				</div>
				<p>
					i think the web should be weird, free, open, federated, and YOURS. i am an advocate for internet privacy,
					federated protocols, and libre software.
				</p>
				<p>
					i am mostly NEGATIVE towards LLMs and other post-2022 generative AI ventures. specifically, i do not support
					image, video, audio, or music generative AI in any form, nor the use of AI in creative writing.
				</p>
				<p>
					i also support the preservation of media bc all cultural works belong to the commons, not extractive
					capitalists.
				</p>
			</section>

			<Divider />

			<section class="my-4">
				<div class="mb-3">
					<h2 class={heading}>elsewhere</h2>
					<p class={leadText}>
						where can the amelia be found. you did not ask that question or you did but im answering it
					</p>
				</div>
				<LinkSection links={socialLinks} />
			</section>
		</article>

		<aside class="xl:hidden bg-ctp-base p-2 pb-0 inset-shadow-sm inset-shadow-ctp-mantle" transition:persist>
			<Arlecchino />
		</aside>
	</div>

	<aside
		slot="right"
		class="max-xl:hidden sticky top-5 bg-ctp-crust border-2 border-dashed border-ctp-base h-fit p-2 m-3 rounded-lg inset-shadow-ctp-mantle"
		transition:persist
	>
		<Arlecchino />
	</aside>
</Base>
