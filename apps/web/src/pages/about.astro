---
import Divider from '@components/formatting/Divider.astro';
import LinkSection from '@components/formatting/LinkSection.astro';
import BackLink from '@components/link/BackLink.astro';
import WrapLink from '@components/link/WrapLink.astro';
import Base from '@layouts/Base.astro';
import { body, heading, leadText, link, pageSubtitle, pageTitle, subHeading } from '@lib/classes';
import { meLinks } from '@lib/data';

const aboutTitle = 'about';
const aboutSub = 'this page is kinda about me AND this site but this site IS me so it works';
---

<Base title={aboutTitle} description={aboutSub}>
	<BackLink />

	<div class="flex max-xl:flex-col gap-4">
		<article>
			<div class="mb-4">
				<h1 class={pageTitle}>{aboutTitle}</h1>
				<p class={pageSubtitle}>{aboutSub}</p>
			</div>

			<Divider />

			<section class="flex flex-col gap-3">
				<div>
					<h2 class={heading}>me</h2>
					<p class={leadText}>
						i am a transfemme lesbian who uses it/she/fae/xe pronouns ^^ also i am a puppygirl (woof) and also i MIGHT
						be butch or masc idfk LMAO. i am also AuDHD gang wooo #RedInstead. also my vision sucks ASS. also ive known
						im a girl since feb 14th, 2021 :p
					</p>
				</div>

				<section>
					<h3 class={subHeading}>tastes</h3>
					<ul class:list={['list-disc list-inside mt-1', body]}>
						<li>
							<WrapLink href="/music" class={link}>music</WrapLink>
						</li>
						<li>
							<WrapLink href="https://backloggd.com/u/nyameliaaaa" class={link}>games (backloggd)</WrapLink>
						</li>
						<li>
							<WrapLink href="https://letterboxd.com/nyamelia/" class={link}>films (letterboxd)</WrapLink>
						</li>
					</ul>
				</section>

				<section>
					<h3 class={subHeading}>links</h3>
					<LinkSection links={meLinks} />
				</section>
			</section>

			<Divider />

			<section class="flex flex-col gap-2">
				<div>
					<h2 class={heading}>beliefs</h2>
					<p class={leadText}>i have opinions and i WILL be sharing them</p>
				</div>
				<p class={body}>
					i think the web should be weird, free, open, federated, and YOURS. i am an advocate for internet privacy,
					federated protocols, and libre software; as you should be able to own your devices, your website, your feed,
					your communications, your media, your source code, and your files, free from any glowie or corporate
					interests. i am mostly NEGATIVE towards LLMs and other post-2022 generative AI ventures. specifically, i do
					not support image, video, audio, or music generative AI in any form, nor the use of AI in creative writing. i
					also support the preservation of media bc all cultural works belong to the commons, not extractive capitalists
				</p>
			</section>
		</article>

		<aside class="xl:hidden bg-ctp-base p-2 pb-0 inset-shadow-sm inset-shadow-ctp-mantle" transition:persist>
			<p class="text-ctp-pink font-medium text-sm text-center">what i look like (real)</p>
			<div class="w-full h-full flex flex-col justify-center items-center">
				<img src="/about/arlecchino.png" alt="arlecchino" class="aspect-2/3" />
			</div>
		</aside>
	</div>

	<aside
		slot="right"
		class="max-xl:hidden sticky top-5 bg-ctp-mantle border-2 border-dashed border-ctp-base h-fit p-2 m-3 rounded-lg inset-shadow-ctp-mantle"
		transition:persist
	>
		<p class="text-ctp-pink font-medium text-sm text-center">what i look like (real)</p>
		<div class="w-full h-full flex flex-col justify-center items-center">
			<img src="/about/arlecchino.png" alt="arlecchino" class="aspect-2/3" />
		</div>
	</aside>
</Base>
