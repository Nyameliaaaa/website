---
import DetailedLinkSection from '@/components/ui/DetailedLinkSection.astro';
import MessageForm from '@components/contact/MessageForm.vue';
import WrapLink from '@components/link/WrapLink.astro';
import Divider from '@components/ui/Divider.astro';
import { gitForgeLinks, pubKeyLinks, reachMeLinks } from '@data/links/contact';
import Page from '@layouts/Page.astro';
import { caption, heading, leadText, link, subHeading } from '@lib/classes';
---

<Page
	title="contact"
	description="locations where the cryptid known as amelia has been found on the interwebs. reports say she was barking, or being barked at, idk"
>
	<Divider />

	<DetailedLinkSection title="reach me" subtitle="how to message me 101" links={reachMeLinks} />

	<Divider />

	<section>
		<h2 class={heading} id="public-keys">public keys</h2>
		<p class={leadText}>-----BEGIN PUBLIC KEY BLOCK-----</p>
		<ul class="mt-2 flex flex-col gap-2">
			{
				pubKeyLinks.map(pubKey => (
					<li>
						<h3 class={subHeading}>
							<WrapLink href={pubKey.url} class:list={[subHeading, link]}>
								{pubKey.label} ↗
							</WrapLink>
						</h3>
						<p class={caption}>{pubKey.comment}</p>
					</li>
				))
			}
		</ul>
	</section>

	<Divider />

	<section>
		<h2 class={heading} id="message">message ^^</h2>
		<p class={leadText}>waow u can talk to the amy???? (real)</p>
		<div class="mt-2">
			<MessageForm client:load />
		</div>
	</section>

	<Divider />

	<DetailedLinkSection title="git forge" links={gitForgeLinks} />

</Page>
