---
import FormattedDate from '@components/ui/FormattedDate.astro';
import CopyrightEnd from '@components/layout/CopyrightEnd.vue';
import IconLink from '@components/link/IconLink.astro';
import WrapLink from '@components/link/WrapLink.astro';
import PixelieImg from '@components/pixelies/PixelieImg.astro';
import { footerLinks } from '@data/navigationLinks';
import { footerPixelies } from '@data/pixelies';
import { caption } from '@lib/classes';
import { version } from 'vue';
---

<footer class={caption}>
	<div class="grid grid-cols-1 md:grid-cols-2 items-start gap-2">
		<small class="flex flex-col gap-3">
			<div>
				<p>
					&copy; copyright 2017-<CopyrightEnd client:load /> amelia cynthia winters
				</p>
				<p>
					ramblings licensed under <WrapLink href="https://creativecommons.org/licenses/by-nc/4.0/">
						CC BY-NC 4.0</WrapLink
					>
				</p>
			</div>

			<div>
				<p>
					soundtrack: <WrapLink href="https://www.youtube.com/watch?v=ERo-sPa1a5g">hachioji p - gimme x gimme</WrapLink>
				</p>
			</div>

			<div>
				<p>
					{Astro.generator.replace('A', 'a')}, vue v{version}
				</p>
				<p>
					commit <WrapLink href={`https://git.gay/nyamelia/website/commit/${import.meta.env.CF_PAGES_COMMIT_SHA}`}
						>{import.meta.env.CF_PAGES_COMMIT_SHA.slice(0, 10)}</WrapLink
					>
				</p>
				<p>
					last updated <b><FormattedDate date={new Date(import.meta.env.PUBLIC_LAST_UPDATED)} /></b>
				</p>
				<p>
					tested using <WrapLink href="https://firefox.com"> firefox</WrapLink>
				</p>
			</div>
		</small>

		<nav>
			<ul class="grid grid-cols-2 lg:grid-cols-2 xl:gap-3 select-none">
				{
					footerLinks.map(url => (
						<li class="mb-2">
							<IconLink {...url} />
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<ul class="mt-3 flex flex-row justify-around gap-2">
		{footerPixelies.map(pixelie => <PixelieImg pixelie={pixelie} />)}
	</ul>
</footer>
