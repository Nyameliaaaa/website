---
import WrapLink from '@components/link/WrapLink.astro';
import { body, link, text } from '@lib/classes';
import type { LinkEntry } from '@lib/types';

interface Props {
	links: LinkEntry[];
}

const { links } = Astro.props;
---

<ul class="flex flex-col gap-2 xl:gap-1 mt-2">
	{
		links.map(linkItem => (
			<li class="flex flex-col xl:grid xl:grid-cols-4">
				<div class="xl:col-span-1">
					<p
						class={text({
							color: 'accent',
							font: 'sans',
							weight: 'medium',
							tracking: 'tight',
						})}
					>
						{linkItem.label}
					</p>
				</div>
				<div class="xl:col-span-3">
					{linkItem.url ? (
						<WrapLink href={linkItem.url} class={`${body} ${link}`}>
							{linkItem.handle}
						</WrapLink>
					) : (
						<p class={body}>{linkItem.handle}</p>
					)}
				</div>
			</li>
		))
	}
</ul>
