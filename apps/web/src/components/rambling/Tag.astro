---
import WrapLink from '@components/link/WrapLink.astro';
import { formFieldLabel } from '@lib/classes';

interface Props {
	tag: string;
}

const { tag } = Astro.props;
---

<WrapLink
	href={`/ramblings/tags/${tag}`}
	class="border-2 border-ctp-surface0 px-2 rounded-md bg-ctp-crust hover:bg-ctp-surface1 transition-colors duration-300 baseAccentOutline"
>
	<p class={formFieldLabel}># {tag}</p>
</WrapLink>
