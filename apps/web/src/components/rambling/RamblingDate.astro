---
import FormattedDate from '@components/ui/FormattedDate.astro';
import { caption, ramblingIcon, ramblingLabel, text } from '@lib/classes';
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'ramblings'>;

const {
	data: { pubDate, updatedDate },
} = Astro.props;
---

<div class="flex flex-row max-lg:gap-1 lg:gap-4 items-center">
	<div class="flex flex-row gap-2 items-center">
		<Icon name="mdi:calendar-clock" size="20" class={ramblingIcon} title="date published" />
		<p class={ramblingLabel}><FormattedDate date={pubDate} /></p>
	</div>
	{
		updatedDate && (
			<div class="flex flex-row gap-2 items-center">
				<Icon name="mdi:calendar-edit" size="20" class={ramblingIcon} title="date created" />
				<p class={ramblingLabel}>
					<FormattedDate date={updatedDate} />
				</p>
			</div>
		)
	}
</div>
